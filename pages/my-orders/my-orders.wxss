/* pages/my-orders/my-orders.wxss */

.status-tabs {
  display: flex;
  white-space: nowrap;
  padding: 24rpx 32rpx;
  background-color: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.status-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.status-tab.active {
  color: var(--primary);
  font-weight: 600;
  position: relative;
}

.status-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--primary);
  border-radius: 2rpx;
}

.order-list {
  padding: 24rpx 32rpx;
}

.order-card {
  background-color: var(--card-bg);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-no {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0;
}

.order-amount {
  font-size: 36rpx;
  color: var(--accent);
  font-weight: 700;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-date {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-actions {
  display: flex;
  gap: 16rpx;
}

.mini {
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  min-height: auto;
  line-height: 1.4;
}

.mini::after {
  border: none;
}
