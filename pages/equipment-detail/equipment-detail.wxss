/* pages/equipment-detail/equipment-detail.wxss */

.img-swiper {
  width: 100%;
  height: 560rpx;
}

.equip-img {
  width: 100%;
  height: 100%;
}

.info-card {
  margin: -40rpx 32rpx 0;
  position: relative;
  z-index: 2;
}

.equip-name {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.equip-model {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 12rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 24rpx;
}

.price {
  font-size: 44rpx;
  color: var(--accent);
  font-weight: 700;
}

.unit {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: normal;
}

.deposit {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.notice-card {
  background-color: var(--secondary);
  border-left: 8rpx solid var(--accent);
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 12rpx;
}

.notice-text {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

.bar-btns {
  display: flex;
  gap: 24rpx;
}

.half {
  flex: 1;
}
