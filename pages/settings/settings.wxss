/* pages/settings/settings.wxss */

.tip {
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.theme-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.theme-card {
  background-color: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  position: relative;
  border: 2rpx solid transparent;
  transition: border-color 0.3s;
}

.theme-card.active {
  border-color: var(--primary);
}

.color-preview {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.color-block {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
}

.theme-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.check {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background-color: var(--primary);
  color: #FFFFFF;
  font-size: 28rpx;
}
