<!--pages/package-detail/package-detail.wxml 套餐详情-->
<view class="page-bg" style="{{pageStyle}}">
  <!-- 封面 -->
  <image class="cover" src="{{pkg.cover_image}}" mode="aspectFill"></image>

  <!-- 基本信息 -->
  <view class="info-card card">
    <view class="pkg-name">{{pkg.name}}</view>
    <view class="pkg-meta">
      <text class="tag tag-primary">{{pkg.type === 'photo' ? '摄影' : '摄像'}}</text>
      <text class="tag">{{pkg.category}}</text>
      <text class="pkg-duration">{{pkg.duration}}小时</text>
    </view>
    <view class="pkg-price">¥{{pkg.priceYuan}}</view>
  </view>

  <!-- 套餐描述 -->
  <view class="card" wx:if="{{pkg.description}}">
    <view class="section-title">套餐介绍</view>
    <view class="desc">{{pkg.description}}</view>
  </view>

  <!-- 包含内容 -->
  <view class="card" wx:if="{{pkg.included_items && pkg.included_items.length}}">
    <view class="section-title">包含内容</view>
    <view class="item-list">
      <view class="item" wx:for="{{pkg.included_items}}" wx:key="*this">
        <text class="dot" style="background:{{theme.primary}}"></text>
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 样片画廊 -->
  <view class="card" wx:if="{{samples.length}}">
    <view class="section-title">样片欣赏</view>
    <view class="sample-grid">
      <block wx:for="{{samples}}" wx:key="index">
        <image wx:if="{{item.type === 'image'}}" class="sample-img" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"></image>
        <video wx:else class="sample-img" src="{{item.url}}" controls show-center-play-btn></video>
      </block>
    </view>
  </view>

  <!-- 预约须知 -->
  <view class="card" wx:if="{{pkg.notice}}">
    <view class="section-title">预约须知</view>
    <view class="desc">{{pkg.notice}}</view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 160rpx;"></view>

  <!-- 底部预约按钮 -->
  <view class="fixed-bottom-bar">
    <button class="btn-primary" bindtap="goBooking">立即预约</button>
  </view>
</view>
