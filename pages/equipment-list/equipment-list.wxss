/* pages/equipment-list/equipment-list.wxss */

.cat-tabs {
  display: flex;
  white-space: nowrap;
  padding: 24rpx 32rpx;
  background-color: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 32rpx;
}

.cat-tab.active {
  background-color: var(--primary);
  color: #FFFFFF;
}

.equip-list {
  padding: 24rpx 32rpx;
}

.equip-card {
  display: flex;
  background-color: var(--card-bg);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.equip-card.locked {
  opacity: 0.5;
}

.lock-tag {
  font-size: 20rpx;
  color: #fff;
  background: #f5a623;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.equip-cover {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.equip-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.equip-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.equip-model {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.equip-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.equip-price {
  font-size: 32rpx;
  color: var(--accent);
  font-weight: 600;
}

.unit {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: normal;
}

.equip-deposit {
  font-size: 22rpx;
  color: var(--text-secondary);
}
