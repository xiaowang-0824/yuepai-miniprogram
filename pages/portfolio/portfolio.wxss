/* pages/portfolio/portfolio.wxss */

.cat-tabs {
  display: flex;
  white-space: nowrap;
  padding: 24rpx 32rpx;
  background-color: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 32rpx;
  transition: all 0.3s;
}

.cat-tab.active {
  background-color: var(--primary);
  color: #FFFFFF;
}

.portfolio-list {
  padding: 24rpx 32rpx;
}

.portfolio-card {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.portfolio-cover {
  width: 100%;
  height: 100%;
}

.portfolio-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6), transparent);
}

.portfolio-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.portfolio-count {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.load-more {
  text-align: center;
  padding: 32rpx;
}
