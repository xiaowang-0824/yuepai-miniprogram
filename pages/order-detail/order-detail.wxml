<!--pages/order-detail/order-detail.wxml 订单详情-->
<view class="page-bg" style="{{pageStyle}}">
  <!-- 状态条 -->
  <view class="status-bar">
    <view class="status-text">{{statusMap[order.order_status]}}</view>
    <view class="status-desc">{{statusDesc}}</view>
  </view>

  <!-- 商品信息 -->
  <view class="card">
    <view class="section-title">商品信息</view>

    <view class="product-item" wx:if="{{order.package_snapshot}}">
      <image class="product-cover" src="{{order.package_snapshot.cover_image}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-name">{{order.package_snapshot.name}}</view>
        <view class="product-meta">拍摄套餐</view>
      </view>
      <view class="product-price">¥{{(order.package_snapshot.price / 100).toFixed(0)}}</view>
    </view>

    <view class="product-item" wx:for="{{order.equipment_items}}" wx:key="equipment_id" wx:if="{{order.equipment_items}}">
      <image class="product-cover" src="{{item.snapshot.images[0]}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-name">{{item.snapshot.name}}</view>
        <view class="product-meta">¥{{(item.daily_rent / 100).toFixed(0)}}/天 × {{item.days}}天</view>
      </view>
      <view class="product-price">¥{{(item.subtotal / 100).toFixed(0)}}</view>
    </view>
  </view>

  <!-- 预约信息 -->
  <view class="card">
    <view class="section-title">预约信息</view>
    <view class="info-row">
      <text class="info-label">拍摄日期</text>
      <text class="info-value">{{order.shooting_date}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shooting_location}}">
      <text class="info-label">拍摄地点</text>
      <text class="info-value">{{order.shooting_location}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">联系人</text>
      <text class="info-value">{{order.contact_name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">手机号</text>
      <text class="info-value">{{order.contact_phone}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
  </view>

  <!-- 问卷 -->
  <view class="card" wx:if="{{questionnaire}}">
    <view class="section-title">拍摄风格问卷</view>
    <block wx:if="{{!questionnaire.is_skipped}}">
      <view class="q-row" wx:if="{{questionnaire.atmosphere}}">
        <text class="q-label">期待氛围</text>
        <text class="q-value">{{questionnaire.atmosphere}}</text>
      </view>
      <view class="q-row" wx:if="{{questionnaire.feeling}}">
        <text class="q-label">想保留的感觉</text>
        <text class="q-value">{{questionnaire.feeling}}</text>
      </view>
      <view class="q-row" wx:if="{{questionnaire.appearance_concerns}}">
        <text class="q-label">介意的细节</text>
        <text class="q-value">{{questionnaire.appearance_concerns}}</text>
      </view>
      <view class="q-row" wx:if="{{questionnaire.reference_images && questionnaire.reference_images.length}}">
        <text class="q-label">参考图</text>
        <view class="ref-imgs">
          <image wx:for="{{questionnaire.reference_images}}" wx:key="*this" class="ref-img" src="{{item}}" mode="aspectFill"></image>
        </view>
      </view>
      <view class="q-row" wx:if="{{questionnaire.message}}">
        <text class="q-label">心里话</text>
        <text class="q-value">{{questionnaire.message}}</text>
      </view>
    </block>
    <view class="q-skipped" wx:else>未填写问卷</view>
  </view>

  <!-- 金额明细 -->
  <view class="card">
    <view class="section-title">金额明细</view>
    <view class="amount-row">
      <text>商品金额</text>
      <text>¥{{(order.total_amount / 100).toFixed(0)}}</text>
    </view>
    <view class="amount-row total">
      <text>实付</text>
      <text class="total-price">¥{{(order.pay_amount / 100).toFixed(0)}}</text>
    </view>
  </view>

  <view style="height: 160rpx;"></view>

  <!-- 底部操作 -->
  <view class="fixed-bottom-bar" wx:if="{{order.order_status === 'pending_payment'}}">
    <view class="bar-btns">
      <button class="btn-outline half" bindtap="cancelOrder">取消订单</button>
      <button class="btn-primary half" bindtap="payOrder">去支付</button>
    </view>
  </view>
</view>
