/* pages/order-detail/order-detail.wxss */

.status-bar {
  padding: 48rpx 32rpx;
  background-color: var(--primary);
  color: #FFFFFF;
}

.status-text {
  font-size: 40rpx;
  font-weight: 600;
}

.status-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.product-item:last-child {
  border-bottom: none;
}

.product-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.product-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.product-price {
  font-size: 28rpx;
  color: var(--accent);
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  width: 160rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: var(--text-primary);
}

.q-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.q-label {
  width: 160rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.q-value {
  flex: 1;
  color: var(--text-primary);
}

.ref-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ref-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.q-skipped {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.amount-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
}

.amount-row.total {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 600;
  border-top: 1rpx solid var(--border-color);
  margin-top: 12rpx;
  padding-top: 24rpx;
}

.total-price {
  color: var(--accent);
}

.bar-btns {
  display: flex;
  gap: 24rpx;
}

.half {
  flex: 1;
}
