/* pages/admin/admin.wxss */

.tab-bar {
  display: flex;
  white-space: nowrap;
  background-color: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  display: inline-block;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-item.active {
  color: var(--primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: var(--primary);
  border-radius: 2rpx;
}

.tab-content {
  padding: 24rpx 32rpx;
}

/* 日历 */
.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--primary);
}

.cal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.calendar {
  background-color: var(--card-bg);
  border-radius: 20rpx;
  padding: 16rpx;
}

.week-row {
  display: flex;
}

.week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
}

.day-cell {
  width: calc(100% / 7);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-num {
  font-size: 26rpx;
  color: var(--text-primary);
}

.day-cell.today .day-num {
  color: var(--primary);
  font-weight: 600;
}

.day-marks {
  display: flex;
  gap: 6rpx;
  margin-top: 6rpx;
}

.mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.mark-photo {
  background-color: var(--primary);
}

.mark-equip {
  background-color: var(--accent);
}

.legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-photo {
  background-color: var(--primary);
}

.dot-equip {
  background-color: var(--accent);
}

.dot-block {
  background-color: #999;
}

.dot-lock {
  background-color: #f5a623;
  border: 2rpx dashed #f5a623;
  background-color: transparent;
}

.mark-block {
  background-color: #999;
}

.mark-lock {
  background-color: transparent;
  border: 2rpx dashed #f5a623;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-box {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  text-align: center;
}

.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-row.col {
  flex-direction: column;
  align-items: stretch;
}

.form-row > text:first-child {
  width: 140rpx;
  font-size: 26rpx;
  color: #666;
}

.form-row input {
  flex: 1;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 26rpx;
}

.picker-txt {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.radio-label {
  margin-right: 24rpx;
  font-size: 26rpx;
}

.equip-check-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.equip-check-item {
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.equip-check-item.checked {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

.modal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 列表通用 */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-btn {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--primary);
  border-radius: 24rpx;
}

.mgr-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mgr-item {
  display: flex;
  align-items: center;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  padding: 20rpx;
}

.mgr-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.mgr-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.mgr-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mgr-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.mgr-actions {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.act {
  font-size: 24rpx;
  color: var(--primary);
}

.act.danger {
  color: var(--accent);
}

.order-item {
  flex-direction: column;
  align-items: stretch;
}

.order-item .mgr-info {
  margin-left: 0;
}

.order-item .mgr-actions {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}
