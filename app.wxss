/* app.wxss - 全局样式 */
/* 设计原则：极简摄影风，大留白，图片优先；颜色通过 CSS 变量跟随主题 */

/* ===== 主题色变量（默认 theme1，各页面会用内联 style 覆盖） ===== */
page {
  --primary: #A89889;
  --secondary: #D9CFC4;
  --background: #F9F7F4;
  --text-primary: #4A443F;
  --text-secondary: #877E75;
  --accent: #C87B69;
  --card-bg: #FFFFFF;
  --border-color: #ECE8E2;

  background-color: var(--background);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ===== 通用容器 ===== */
.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.page-bg {
  min-height: 100vh;
  background-color: var(--background);
}

/* ===== 间距工具类 ===== */
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }

/* ===== 文字 ===== */
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.subtitle {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-accent { color: var(--accent); }
.text-primary-color { color: var(--primary); }

/* ===== 卡片 ===== */
.card {
  background-color: var(--card-bg);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

/* ===== 按钮 ===== */
.btn-primary {
  background-color: var(--primary);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background-color: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

.btn-accent {
  background-color: var(--accent);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
}

.btn-accent::after {
  border: none;
}

/* 禁用态 */
.btn-disabled {
  opacity: 0.5;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  background-color: var(--secondary);
  color: var(--text-primary);
}

.tag-primary {
  background-color: var(--primary);
  color: #FFFFFF;
}

.tag-accent {
  background-color: var(--accent);
  color: #FFFFFF;
}

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background-color: var(--border-color);
  margin: 32rpx 0;
}

/* ===== 空状态 ===== */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* ===== 固定底部按钮栏 ===== */
.fixed-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: var(--card-bg);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

/* ===== 图片占位 ===== */
.image-placeholder {
  background-color: var(--secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 24rpx;
}

/* 全局图片默认填满 */
image {
  display: block;
}
